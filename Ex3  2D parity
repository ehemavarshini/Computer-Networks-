#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* --- UTILITY FUNCTIONS --- */

void charToBinary(char c, char *out) {
    int i;
    for (i = 7; i >= 0; i--)
        out[7 - i] = ((c >> i) & 1) ? '1' : '0';
    out[8] = '\0';
}

char binaryToChar(const char *bin) {
    return (char)strtol(bin, NULL, 2);
}

char calculate_even_parity(const char *bits) {
    int count = 0, i;
    for (i = 0; i < (int)strlen(bits); i++) {
        if (bits[i] == '1') count++;
    }
    return (count % 2 == 0) ? '0' : '1';
}

void getSpacedBits(const char *in, char *out) {
    int i, j = 0;
    for (i = 0; i < 8; i++) {
        out[j++] = in[i];
        if (i < 7) out[j++] = ' ';
    }
    out[j] = '\0';
}

/* --- SENDER SIDE LOGIC --- */

void senderSide() {
    FILE *infile, *outfile;
    char ch;
    char binaryMatrix[100][10];
    char lrc_byte[10];
    char spaced[20];
    int rowCount = 0, i, j, colOnes;

    infile = fopen("input.txt", "r");
    if (infile == NULL) {
        printf("Error: Please create 'input.txt' first!\n");
        return;
    }
    outfile = fopen("transmitted_data.txt", "w");

    printf("\n--- SENDER: 2D MATRIX GENERATION ---\n");
    printf("| %-12s | %-15s | %-7s | %-15s |\n", "Byte Name", "8-Bit Data", "VRC bit", "Combined Frame");
    printf("| :--- | :--- | :--- | :--- |\n");

    while ((ch = fgetc(infile)) != EOF) {
        if (ch == '\n' || ch == '\r') continue;
        charToBinary(ch, binaryMatrix[rowCount]);
        binaryMatrix[rowCount][8] = calculate_even_parity(binaryMatrix[rowCount]);
        binaryMatrix[rowCount][9] = '\0';
        getSpacedBits(binaryMatrix[rowCount], spaced);
        printf("| Row %-2d ('%c')  | %-15s | %-7c | %-15s |\n",
               rowCount, ch, spaced, binaryMatrix[rowCount][8], binaryMatrix[rowCount]);
        rowCount++;
    }

    for (j = 0; j < 9; j++) {
        colOnes = 0;
        for (i = 0; i < rowCount; i++) {
            if (binaryMatrix[i][j] == '1') colOnes++;
        }
        lrc_byte[j] = (colOnes % 2 == 0) ? '0' : '1';
    }
    lrc_byte[9] = '\0';

    char lrcOnly8[9];
    strncpy(lrcOnly8, lrc_byte, 8); lrcOnly8[8] = '\0';
    getSpacedBits(lrcOnly8, spaced);
    printf("| %-12s | %-15s | %-7c | %-15s |\n", "LRC Byte", spaced, lrc_byte[8], lrc_byte);

    for (i = 0; i < rowCount; i++) fprintf(outfile, "%s ", binaryMatrix[i]);
    fprintf(outfile, "%s", lrc_byte);

    fclose(infile); fclose(outfile);
    printf("\n[SUCCESS] 2D Matrix written to 'transmitted_data.txt'\n");
}

/* --- RECEIVER SIDE LOGIC (UPDATED FOR MULTIPLE ERRORS) --- */

void receiverSide() {
    FILE *fp;
    char frames[100][10];
    char choice[10];
    char dataPart[9];
    int totalFrames = 0, i, j, f_idx, b_idx, errorFound = 0, colCount;
    int numErrors, k; /* Added for multiple error injection */

    fp = fopen("transmitted_data.txt", "r");
    if (!fp) {
        printf("Error: transmitted_data.txt not found!\n");
        return;
    }
    while (fscanf(fp, "%9s", frames[totalFrames]) != EOF) totalFrames++;
    fclose(fp);

    printf("\nReceived 2D Parity Matrix:\n");
    for (i = 0; i < totalFrames; i++) {
        printf("[%d] [%s] %s\n", i, frames[i], (i == totalFrames - 1) ? "<-- LRC Byte" : "");
    }

    printf("\nDo you want to corrupt bits? (yes/no): ");
    scanf("%s", choice);

    if (strcmp(choice, "yes") == 0) {
        printf("How many bits do you want to flip? ");
        scanf("%d", &numErrors);

        for (k = 0; k < numErrors; k++) {
            printf("Error %d: Enter frame index (0-%d): ", k + 1, totalFrames - 1);
            scanf("%d", &f_idx);
            printf("Error %d: Enter bit index (0-8): ", k + 1);
            scanf("%d", &b_idx);

            if (f_idx < totalFrames && b_idx < 9) {
                frames[f_idx][b_idx] = (frames[f_idx][b_idx] == '0') ? '1' : '0';
                printf("[MODIFIED] Bit flipped. Frame %d is now: %s\n", f_idx, frames[f_idx]);
            } else {
                printf("[ERROR] Invalid index!\n");
            }
        }
    }

    /* --- Verification Logic --- */
    printf("\n--- 2D Parity Verification Results ---\n");

    for (i = 0; i < totalFrames - 1; i++) {
        strncpy(dataPart, frames[i], 8);
        dataPart[8] = '\0';
        if (calculate_even_parity(dataPart) != frames[i][8]) {
            printf("VRC Check: Error detected in Row %d\n", i);
            errorFound = 1;
        }
    }

    for (j = 0; j < 9; j++) {
        colCount = 0;
        for (i = 0; i < totalFrames - 1; i++) {
            if (frames[i][j] == '1') colCount++;
        }
        if (((colCount % 2 == 0) ? '0' : '1') != frames[totalFrames - 1][j]) {
            printf("LRC Check: Error detected in Column %d\n", j);
            errorFound = 1;
        }
    }

    if (!errorFound) {
        printf("\nDECISION: Error not present / Valid Data!\n");
        printf("(Note: If you injected 4 bits in a square, this shows how errors can be undetectable!)\n");
        printf("Decoded Text: \"");
        for (i = 0; i < totalFrames - 1; i++) {
            strncpy(dataPart, frames[i], 8); dataPart[8] = '\0';
            printf("%c", binaryToChar(dataPart));
        }
        printf("\"\n");
    } else {
        printf("\nDECISION: Error occurs / Invalid Data!\n");
    }
}

int main() {
    int choice;
    while (1) {
        printf("\n===== 2D PARITY TOOL (VRC/LRC) =====\n");
        printf("1. Sender Side\n2. Receiver Side\n3. Exit\nChoice: ");
        if (scanf("%d", &choice) != 1) break;
        if (choice == 1) senderSide();
        else if (choice == 2) receiverSide();
        else break;
    }
    return 0;
}
