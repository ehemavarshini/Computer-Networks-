// sender

#include <stdio.h>
#include <math.h>
#include <string.h>

int main()
{
    int data[1000], code[1500];
    int m, r = 0, total;
    int i, j, k, check, bit;
    FILE *fp;
    char filename[100];
    char textInput[200];
    char binaryString[1000] = "";

    printf("Enter the input filename: ");
    if (scanf("%99s", filename) != 1) return 1;

    fp = fopen(filename, "r");
    if (fp == NULL)
    {
        printf("Error: Could not open file %s\n", filename);
        return 1;
    }

    if (fscanf(fp, "%199s", textInput) != 1)
    {
        printf("Error: Input file is empty or invalid.\n");
        fclose(fp);
        return 1;
    }
    fclose(fp);

    printf("Fetched Data String from file: %s\n", textInput);

    for (i = 0; textInput[i] != '\0'; i++)
    {
        char ch = textInput[i];
        for (bit = 7; bit >= 0; bit--)
        {
            if ((ch >> bit) & 1)
                strcat(binaryString, "1");
            else
                strcat(binaryString, "0");
        }
    }

    printf("Converted Binary String: %s\n", binaryString);

    m = strlen(binaryString);

    for(i = 1; i <= m; i++)
    {
        data[i] = binaryString[m - i] - '0';
    }

    while(pow(2, r) < (m + r + 1))
        r++;

    total = m + r;

    printf("\nPlacing Data Bits\n");

    j = 1;
    k = 1;

    for(i = 1; i <= total; i++)
    {
        if(i == (int)pow(2, j - 1))
        {
            code[i] = 0;
            printf("Index %2d: P%d (Reserved for Parity)\n", i, i);
            j++;
        }
        else
        {
            code[i] = data[k];
            printf("Index %2d: D%d = %d\n", i, k, data[k]);
            k++;
        }
    }

    printf("\nCalculating Parity Bits (Even Parity)\n");

    for(i = 0; i < r; i++)
    {
        int p = (int)pow(2, i);
        int count = 0;

        printf("Calculating P%d (checking indices where bit %d is set):\n  ", p, i + 1);

        int first = 1;

        for(j = 1; j <= total; j++)
        {
            if(j & p)
            {
                if(j != p)
                {
                    if(!first)
                        printf(" ");

                    printf("%dval:%d", j, code[j]);
                    first = 0;

                    if(code[j] == 1)
                        count++;
                }
            }
        }

        if(count % 2 == 0)
            code[p] = 0;
        else
            code[p] = 1;

        printf("\n  Result: P%d = %d\n\n", p, code[p]);
    }

    printf("Final Combined Array Layout\n");

    printf("Position:  ");
    int data_printed = m;
    for(i = total; i >= 1; i--)
    {
        if((i & (i - 1)) == 0)
        {
            printf("P%-3d", i);
        }
        else
        {
            printf("D%-3d", data_printed);
            data_printed--;
        }
    }

    printf("\nBit Value: ");
    for(i = total; i >= 1; i--)
    {
        printf("%-4d", code[i]);
    }

    printf("\n\n");
    printf("Added %d parity bits. Total block size: %d bits.\n", r, total);

    fp = fopen("hamming.txt", "w");

    if(fp != NULL)
    {
        fprintf(fp, "%d\n", total);

        for(i = 1; i <= total; i++)
            fprintf(fp, "%d ", code[i]);

        fclose(fp);
    }

    printf("\nData stored successfully in hamming.txt\n");

    return 0;
}





//Receiver

#include <stdio.h>
#include <math.h>
#include <string.h>

int main()
{
    int code[1500];
    int data[1000];
    int total, r = 0, m;
    int i, j, k, bit, p;
    int error_pos;
    char choice;
    FILE *fp;
    char binaryString[1000] = "";
    char textOutput[200] = "";

    fp = fopen("hamming.txt", "r");
    if (fp == NULL)
    {
        printf("Error: Could not open hamming.txt\n");
        return 1;
    }

    if (fscanf(fp, "%d", &total) != 1)
    {
        printf("Error: Invalid file format.\n");
        fclose(fp);
        return 1;
    }

    for (i = 1; i <= total; i++)
    {
        if (fscanf(fp, "%d", &code[i]) != 1)
        {
            printf("Error: Incomplete data.\n");
            fclose(fp);
            return 1;
        }
    }
    fclose(fp);

    printf("---------------- HAMMING CODE RECEIVER ----------------\n\n");
    printf("Received Hamming Code : ");
    for (i = total; i >= 1; i--)
    {
        printf("%d", code[i]);
    }
    printf("\n\n");

    while (pow(2, r) < (total + 1))
        r++;

    printf("Checking Parity Bits (Even Parity)\n\n");
    error_pos = 0;
    for (i = 0; i < r; i++)
    {
        p = (int)pow(2, i);
        int data_count = 0;
        int stored_p = code[p];

        printf("Checking P%d (checking indices ", p);
        int first_index = 1;
        for (j = 1; j <= total; j++)
        {
            if (j & p)
            {
                if (!first_index) printf(", ");
                printf("%d", j);
                first_index = 0;
            }
        }
        printf("):\n  Bits -> ");

        int first_val = 1;
        for (j = 1; j <= total; j++)
        {
            if (j & p)
            {
                if (!first_val) printf(" ");
                printf("%dval:%d", j, code[j]);
                first_val = 0;
                if (j != p && code[j] == 1)
                    data_count++;
            }
        }
        printf("\n");

        int recalculated_p = (data_count % 2 == 0) ? 0 : 1;
        printf("  Stored P%d = %d | Recalculated P%d = %d\n", p, stored_p, p, recalculated_p);

        if (stored_p != recalculated_p)
        {
            error_pos += p;
            printf("  Result: Incorrect\n\n");
        }
        else
        {
            printf("  Result: Correct\n\n");
        }
    }

    if (error_pos == 0)
    {
        printf("No Error Detected.\n\n");
    }

    k = 1;
    for (i = 1; i <= total; i++)
    {
        if ((i & (i - 1)) != 0)
        {
            data[k] = code[i];
            k++;
        }
    }
    m = k - 1;

    printf("Original Data Bits : ");
    for (i = m; i >= 1; i--)
    {
        printf("%d", data[i]);
    }
    printf("\n\n");

    printf("Do you want to introduce an error? (Y/N): ");
    if (scanf(" %c", &choice) != 1) return 1;

    if (choice == 'y' || choice == 'Y')
    {
        int user_flip;
        printf("Enter bit position to flip (1 to %d): ", total);
        if (scanf("%d", &user_flip) != 1) return 1;

        if (user_flip >= 1 && user_flip <= total)
        {
            code[user_flip] = !code[user_flip];
            printf("\nBit %d has been flipped.\n\n", user_flip);
        }
        else
        {
            printf("Invalid position.\n");
            return 1;
        }

        printf("Corrupted Hamming Code : ");
        for (i = total; i >= 1; i--)
        {
            printf("%d", code[i]);
        }
        printf("\n\n");

        printf("Checking Parity Bits Again (Even Parity)\n\n");
        error_pos = 0;
        for (i = 0; i < r; i++)
        {
            p = (int)pow(2, i);
            int data_count = 0;
            int stored_p = code[p];

            printf("Checking P%d (checking indices ", p);
            int first_index = 1;
            for (j = 1; j <= total; j++)
            {
                if (j & p)
                {
                    if (!first_index) printf(", ");
                    printf("%d", j);
                    first_index = 0;
                }
            }
            printf("):\n  Bits -> ");

            int first_val = 1;
            for (j = 1; j <= total; j++)
            {
                if (j & p)
                {
                    if (!first_val) printf(" ");
                    printf("%dval:%d", j, code[j]);
                    first_val = 0;
                    if (j != p && code[j] == 1)
                        data_count++;
                }
            }
            printf("\n");

            int recalculated_p = (data_count % 2 == 0) ? 0 : 1;
            printf("  Stored P%d = %d | Recalculated P%d = %d\n", p, stored_p, p, recalculated_p);

            if (stored_p != recalculated_p)
            {
                error_pos += p;
                printf("  Result: Incorrect\n\n");
            }
            else
            {
                printf("  Result: Correct\n\n");
            }
        }

        printf("Syndrome (Binary) : ");
        for (i = r - 1; i >= 0; i--)
        {
            int check_bit = (error_pos >> i) & 1;
            printf("%d", check_bit);
        }
        printf("\nSyndrome (Decimal): %d\n\n", error_pos);

        if (error_pos != 0 && error_pos <= total)
        {
            printf("Error Detected at Bit Position : %d\n\n", error_pos);
            code[error_pos] = !code[error_pos];

            printf("Corrected Hamming Code : ");
            for (i = total; i >= 1; i--)
            {
                printf("%d", code[i]);
            }
            printf("\n\n");
        }
        else if (error_pos > total)
        {
            printf("Multiple uncorrectable errors detected.\n\n");
            return 1;
        }
    }

    k = 1;
    int idx = 0;
    for (i = 1; i <= total; i++)
    {
        if ((i & (i - 1)) != 0)
        {
            data[k] = code[i];
            binaryString[idx++] = data[k] + '0';
            k++;
        }
    }
    m = k - 1;
    binaryString[idx] = '\0';

    int str_len = strlen(binaryString);
    char finalBinary[1000] = "";
    int fb_idx = 0;
    for (i = str_len - 1; i >= 0; i--)
    {
        finalBinary[fb_idx++] = binaryString[i];
    }
    finalBinary[fb_idx] = '\0';

    int text_len = m / 8;
    for (i = 0; i < text_len; i++)
    {
        char ch = 0;
        for (bit = 0; bit < 8; bit++)
        {
            int bit_val = finalBinary[i * 8 + bit] - '0';
            ch = (ch << 1) | bit_val;
        }
        textOutput[i] = ch;
    }
    textOutput[text_len] = '\0';

    printf("Original Data Bits : ");
    for (i = m; i >= 1; i--)
    {
        printf("%d", data[i]);
    }
    printf("\n\nDecoded Text String Message: %s\n", textOutput);

    return 0;
}
