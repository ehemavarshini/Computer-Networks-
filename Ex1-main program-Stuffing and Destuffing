#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define MAX_URL 50
#define MAX_IP 16
#define MAX_MAC 18
#define HASH_SIZE 5

/* Global Constants */
char FLAG[] = "01111110";
char ESC[]  = "01111101";

struct HashEntry {
    char url[MAX_URL];
    char ip[MAX_IP];
    char mac[MAX_MAC];
    int is_occupied;
};

struct ProtocolEntry {
    char name[10];
    char hex[10];
};

struct HashEntry hashTable[HASH_SIZE];
struct ProtocolEntry pTable[4] = {
    {"IPv4", "0021"},
    {"IPv6", "0057"},
    {"LCP",  "C021"},
    {"PAP",  "C023"}
};

/* --- UTILITY FUNCTIONS --- */

void getCharBinaryStr(char c, char *outStr) {
    int i;
    for (i = 7; i >= 0; i--) {
        outStr[7-i] = ((c >> i) & 1) + '0';
    }
    outStr[8] = '\0';
}

char binaryToChar(const char *bin) {
    return (char)strtol(bin, NULL, 2);
}

void printWithSpaces(const char *bin) {
    int i;
    for (i = 0; bin[i] != '\0'; i++) {
        if (i > 0 && i % 8 == 0) printf(" ");
        printf("%c", bin[i]);
    }
}

void fprintWithSpaces(FILE *fp, const char *bin) {
    int i;
    for (i = 0; bin[i] != '\0'; i++) {
        if (i > 0 && i % 8 == 0) fprintf(fp, " ");
        fprintf(fp, "%c", bin[i]);
    }
}

void getIpBinaryStr(const char *ip, char *outStr) {
    int v[4], p, i;
    outStr[0] = '\0';
    if (sscanf(ip, "%d.%d.%d.%d", &v[0], &v[1], &v[2], &v[3]) == 4) {
        for (p = 0; p < 4; p++) {
            char b[9];
            for (i = 7; i >= 0; i--) b[7-i] = ((v[p] >> i) & 1) + '0';
            b[8] = '\0'; strcat(outStr, b);
        }
    }
}

void getMacBinaryStr(const char *mac, char *outStr) {
    unsigned int m[6];
    int p, i;
    outStr[0] = '\0';
    if (sscanf(mac, "%x:%x:%x:%x:%x:%x", &m[0], &m[1], &m[2], &m[3], &m[4], &m[5]) == 6 ||
        sscanf(mac, "%X:%X:%X:%X:%X:%X", &m[0], &m[1], &m[2], &m[3], &m[4], &m[5]) == 6) {
        for (p = 0; p < 6; p++) {
            char b[9];
            for (i = 7; i >= 0; i--) b[7-i] = ((m[p] >> i) & 1) + '0';
            b[8] = '\0'; strcat(outStr, b);
        }
    }
}

/* --- STUFFING LOGIC --- */

void byteStuffing(const char *input, char *output) {
    int i = 0;
    char byte[9];
    output[0] = '\0';
    while (input[i] != '\0') {
        strncpy(byte, &input[i], 8);
        byte[8] = '\0';
        if (strcmp(byte, FLAG) == 0 || strcmp(byte, ESC) == 0) strcat(output, ESC);
        strcat(output, byte);
        i += 8;
    }
}

void byteDestuffing(const char *input, char *output) {
    int i = 0;
    char byte[9];
    output[0] = '\0';
    while (input[i] != '\0') {
        strncpy(byte, &input[i], 8);
        byte[8] = '\0';
        if (strcmp(byte, ESC) == 0) {
            i += 8;
            strncpy(byte, &input[i], 8);
            byte[8] = '\0';
        }
        strcat(output, byte);
        i += 8;
    }
}

void bitStuffing(const char *input, char *output) {
    int i, count = 0, j = 0;
    for (i = 0; input[i] != '\0'; i++) {
        output[j++] = input[i];
        if (input[i] == '1') count++;
        else count = 0;
        if (count == 5) {
            output[j++] = '0';
            count = 0;
        }
    }
    output[j] = '\0';
}

void bitDestuffing(const char *input, char *output) {
    int i, count = 0, j = 0;
    for (i = 0; input[i] != '\0'; i++) {
        output[j++] = input[i];
        if (input[i] == '1') count++;
        else count = 0;
        if (count == 5 && input[i+1] == '0') {
            i++;
            count = 0;
        }
    }
    output[j] = '\0';
}

/* --- HASH TABLE --- */

void insertNode(const char *url, const char *ip, const char *mac) {
    int sum = 0, i, index;
    for (i = 0; url[i] != '\0'; i++) sum += url[i];
    index = sum % HASH_SIZE;
    while (hashTable[index].is_occupied) index = (index + 1) % HASH_SIZE;
    strcpy(hashTable[index].url, url);
    strcpy(hashTable[index].ip, ip);
    strcpy(hashTable[index].mac, mac);
    hashTable[index].is_occupied = 1;
}

void viewHashTable() {
    int i;
    printf("\n--- CURRENT NETWORK NODES (HASH TABLE) ---\n");
    printf("%-5s\t%-15s\t%-15s\t%-15s\n", "Index", "URL", "IP Address", "MAC Address");
    for(i=0; i<HASH_SIZE; i++) {
        if(hashTable[i].is_occupied)
            printf("[%d]\t%-15s\t%-15s\t%-15s\n", i, hashTable[i].url, hashTable[i].ip, hashTable[i].mac);
        else printf("[%d]\tEMPTY\n", i);
    }
}

/* --- SENDER SIDE --- */

void senderSide() {
    char sUrl[MAX_URL], dUrl[MAX_URL], msg[100];
    char appBin[800] = "", segPay[2000] = "", sib[40], dib[40], smb[60], dmb[60];
    char byteStuffed[3000] = "", bitStuffed[3000] = "";
    char pppRaw[4000] = "", pppByteStuffed[4000] = "", pppBitStuffed[4000] = "";
    int pIdx, i, j, sI = -1, dI = -1, psz, fsz, totalSegLen, numPackets, frameCount, startIdx;
    FILE *fp;

    printf("\n--- STEP 1: PROTOCOL FIELD TABLE ---\nID\tProtocol\tHex\n");
    for(i=0; i<4; i++) printf("[%d]\t%-10s\t%s\n", i, pTable[i].name, pTable[i].hex);
    printf("Select Protocol ID: "); scanf("%d", &pIdx);

    printf("\nSource URL: "); scanf("%s", sUrl);
    printf("Dest URL  : "); scanf("%s", dUrl);

    printf("Enter Message/Data to transmit: ");
    scanf(" %[^\n]s", msg);

    printf("Packet Bit Size: "); scanf("%d", &psz);
    printf("Frame Bit Size : "); scanf("%d", &fsz);

    for(i=0; i<HASH_SIZE; i++) {
        if(hashTable[i].is_occupied && strcmp(hashTable[i].url, sUrl)==0) sI = i;
        if(hashTable[i].is_occupied && strcmp(hashTable[i].url, dUrl)==0) dI = i;
    }
    if(sI == -1 || dI == -1) { printf("Error: Node not found.\n"); return; }

    getIpBinaryStr(hashTable[sI].ip, sib);
    getIpBinaryStr(hashTable[dI].ip, dib);
    getMacBinaryStr(hashTable[sI].mac, smb);
    getMacBinaryStr(hashTable[dI].mac, dmb);

    /* --- APPLICATION LAYER --- */
    for(i=0; msg[i]; i++) {
        char b[9]; getCharBinaryStr(msg[i], b);
        strcat(appBin, b);
    }

    /* --- TRANSPORT LAYER --- */
    char sPort[] = "0000010000000000";
    char dPort[] = "0001111110010000";
    sprintf(segPay, "%s%s%s", sPort, dPort, appBin);

    /* --- STUFFING CALCULATIONS --- */
    byteStuffing(segPay, byteStuffed);
    bitStuffing(segPay, bitStuffed);

    /* --- PPP FRAME CONSTRUCTION --- */
    sprintf(pppRaw, "%s | 11111111 | 00000011 | %s | %s | FCS | %s", FLAG, pTable[pIdx].hex, segPay, FLAG);
    sprintf(pppByteStuffed, "%s | 11111111 | 00000011 | %s | %s | FCS | %s", FLAG, pTable[pIdx].hex, byteStuffed, FLAG);
    sprintf(pppBitStuffed, "%s | 11111111 | 00000011 | %s | %s | FCS | %s", FLAG, pTable[pIdx].hex, bitStuffed, FLAG);

    printf("\n====================================\nPPP FRAME (SENDER SIDE)\n====================================\n");
    printf("Raw PPP Piped: %s\n", pppRaw);

    fp = fopen("transmission.txt", "w");
    if(fp) {
        // Line 1: Byte Stuffed Piped
        // Line 2: Bit Stuffed Piped
        // Line 3: Raw Piped
        // Line 4: Protocol Name
        fprintf(fp, "%s\n%s\n%s\n%s", pppByteStuffed, pppBitStuffed, pppRaw, pTable[pIdx].name);
        fclose(fp);
        printf("\n[SENDER] Piped stuffed frames transmitted to 'transmission.txt'\n");
    }
}

/* --- RECEIVER SIDE --- */

void receiverSide() {
    FILE *fp, *outFp;
    char pppRaw[4000], pppByteStuffed[4000], pppBitStuffed[4000], protName[10];
    char byteStuffed[3000], bitStuffed[3000], byteDestuffed[2000], finalMsg[100] = "";
    int i;

    fp = fopen("transmission.txt", "r");
    if(!fp) { printf("\nError: No transmission found.\n"); return; }

    fgets(pppByteStuffed, 4000, fp); pppByteStuffed[strcspn(pppByteStuffed, "\n")] = 0;
    fgets(pppBitStuffed, 4000, fp);  pppBitStuffed[strcspn(pppBitStuffed, "\n")] = 0;
    fgets(pppRaw, 4000, fp);         pppRaw[strcspn(pppRaw, "\n")] = 0;
    fscanf(fp, "%s", protName);
    fclose(fp);

    // Extract the stuffed segments from the piped frames for processing
    // Logic: The segment starts after the 4th pipe ' | '
    char *token;
    char temp[4000];

    // Extract Byte Stuffed Segment
    strcpy(temp, pppByteStuffed);
    token = strtok(temp, "|"); // Flag
    token = strtok(NULL, "|"); // Address
    token = strtok(NULL, "|"); // Control
    token = strtok(NULL, "|"); // Protocol
    token = strtok(NULL, "|"); // THIS IS THE STUFFED SEGMENT
    strcpy(byteStuffed, token + 1); // skip space
    byteStuffed[strlen(byteStuffed)-1] = '\0'; // remove trailing space

    // Extract Bit Stuffed Segment
    strcpy(temp, pppBitStuffed);
    token = strtok(temp, "|");
    token = strtok(NULL, "|");
    token = strtok(NULL, "|");
    token = strtok(NULL, "|");
    token = strtok(NULL, "|");
    strcpy(bitStuffed, token + 1);
    bitStuffed[strlen(bitStuffed)-1] = '\0';

    outFp = fopen("receiver_output.txt", "w");
    if(!outFp) { printf("Error: Could not create output file.\n"); return; }

    printf("\n======================================================\n");
    printf("RECEIVER SIDE PROCESSING\n");
    printf("======================================================\n");

    /* --- DISPLAY STUFFED PPP FRAMES IN LOG --- */
    fprintf(outFp, "======================================================\n");
    fprintf(outFp, "STUFFED PPP FRAMES (RECEIVED)\n");
    fprintf(outFp, "======================================================\n");
    fprintf(outFp, "BYTE STUFFED PPP: %s\n", pppByteStuffed);
    fprintf(outFp, "BIT STUFFED PPP:  %s\n\n", pppBitStuffed);

    printf("Byte Stuffed PPP received and logged.\n");
    printf("Bit Stuffed PPP received and logged.\n");

    /* --- PROCESSING & DESTUFFING --- */
    byteDestuffing(byteStuffed, byteDestuffed);

    fprintf(outFp, "======================================================\n");
    fprintf(outFp, "DESTUFFED RESULTS\n");
    fprintf(outFp, "======================================================\n");
    fprintf(outFp, "Byte Destuffed Binary: "); fprintWithSpaces(outFp, byteDestuffed); fprintf(outFp, "\n");

    // Message Recovery
    for(i = 32; i < (int)strlen(byteDestuffed); i+=8) {
        char b[9]; char c;
        strncpy(b, &byteDestuffed[i], 8); b[8]='\0';
        c = binaryToChar(b);
        if(c >= 32 && c <= 126) strncat(finalMsg, &c, 1);
    }

    printf("\nRecovered Message: %s\n", finalMsg);
    fprintf(outFp, "\nRecovered Message: %s\n", finalMsg);

    fclose(outFp);
    printf("\n[RECEIVER] Stuffed PPP frames and recovered data saved to 'receiver_output.txt'\n");
}

int main() {
    int choice, i;
    for(i=0; i<HASH_SIZE; i++) hashTable[i].is_occupied = 0;
    insertNode("google.com", "142.250.190.46", "AA:BB:CC:DD:EE:FF");
    insertNode("bing.com", "13.107.21.200", "11:22:33:44:55:66");

    while(1) {
        printf("\n========== NETWORK TOOL MENU ==========\n");
        printf("1. Add New Network Node\n");
        printf("2. View Network Table (Hash Table)\n");
        printf("3. Sender Side (Stuffing & Transmit)\n");
        printf("4. Receiver Side (Destuff & Recover)\n");
        printf("5. Exit\nChoice: ");
        if(scanf("%d", &choice) != 1) break;

        if(choice == 1) {
            char u[50], ip[16], mac[18];
            printf("Enter URL IP MAC: "); scanf("%s %s %s", u, ip, mac);
            insertNode(u, ip, mac);
        }
        else if(choice == 2) viewHashTable();
        else if(choice == 3) senderSide();
        else if(choice == 4) receiverSide();
        else break;
    }
    return 0;
}
