#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#define MAX_URL 50
#define MAX_IP 16
#define MAX_MAC 18
#define HASH_SIZE 5
struct HashEntry {
    char url[MAX_URL];
    char ip[MAX_IP];
    char mac[MAX_MAC];
    int is_occupied;
};
struct HashEntry hashTable[HASH_SIZE];

/* =======================================================
   1. HASH TABLE FUNCTIONS
   ======================================================= */
int getHashIndex(const char *url) {
    int sum = 0;
    int i;
    for (i = 0; url[i] != '\0'; i++) {
        sum += url[i];
    }
    return sum % HASH_SIZE;
}
void insertNode(const char *url, const char *ip, const char *mac) {
    int index = getHashIndex(url);
    int originalIndex = index;
    while (hashTable[index].is_occupied == 1) {
        if (strcmp(hashTable[index].url, url) == 0) {
            strncpy(hashTable[index].ip, ip, MAX_IP - 1);
            strncpy(hashTable[index].mac, mac, MAX_MAC - 1);
            return;
        }
        index = (index + 1) % HASH_SIZE;
        if (index == originalIndex) return;
    }
    strncpy(hashTable[index].url, url, MAX_URL - 1);
    strncpy(hashTable[index].ip, ip, MAX_IP - 1);
    strncpy(hashTable[index].mac, mac, MAX_MAC - 1);
    hashTable[index].is_occupied = 1;
}
int searchTable(const char *url) {
    int index = getHashIndex(url);
    int originalIndex = index;
    while (hashTable[index].is_occupied != 0) {
        if (hashTable[index].is_occupied == 1 && strcmp(hashTable[index].url, url) == 0) return index;
        index = (index + 1) % HASH_SIZE;
        if (index == originalIndex) break;
    }
    return -1;
}

void printTable() {
    int i;
    printf("\n--- CURRENT NETWORK NODES ---\n");
    for (i = 0; i < HASH_SIZE; i++) {
        if (hashTable[i].is_occupied == 1)
            printf("[%d] URL: %-15s IP: %-15s MAC: %s\n", i, hashTable[i].url, hashTable[i].ip, hashTable[i].mac);
        else printf("[%d] EMPTY\n", i);
    }
}

/* =======================================================
   2. BINARY CONVERSION HELPERS
   ======================================================= */

void getIpBinaryStr(const char *ip, char *outStr) {
    int v[4], p, i;
    outStr[0] = '\0';
    if (sscanf(ip, "%d.%d.%d.%d", &v[0], &v[1], &v[2], &v[3]) == 4) {
        for (p = 0; p < 4; p++) {
            for (i = 7; i >= 0; i--) {
                char t[2]; t[0] = (char)(((v[p] >> i) & 1) + '0'); t[1] = '\0';
                strcat(outStr, t);
            }
            if (p < 3) strcat(outStr, " ");
        }
    }
}

void getMacBinaryStr(const char *mac, char *outStr) {
    unsigned int m[6]; int p, i;
    outStr[0] = '\0';
    if (sscanf(mac, "%x:%x:%x:%x:%x:%x", &m[0], &m[1], &m[2], &m[3], &m[4], &m[5]) == 6) {
        for (p = 0; p < 6; p++) {
            for (i = 7; i >= 0; i--) {
                char t[2]; t[0] = (char)(((m[p] >> i) & 1) + '0'); t[1] = '\0';
                strcat(outStr, t);
            }
            if (p < 5) strcat(outStr, " ");
        }
    }
}

void getPortBinaryStr(int port, char *outStr) {
    int i; outStr[0] = '\0';
    for (i = 15; i >= 0; i--) {
        char t[2]; t[0] = (char)(((port >> i) & 1) + '0'); t[1] = '\0';
        strcat(outStr, t); if (i == 8) strcat(outStr, " ");
    }
}

void getCharBinaryStr(char c, char *outStr) {
    int i; outStr[0] = '\0';
    for (i = 7; i >= 0; i--) {
        char t[2]; t[0] = (char)(((c >> i) & 1) + '0'); t[1] = '\0';
        strcat(outStr, t);
    }
}

/* =======================================================
   3. OSI LAYER FUNCTIONS
   ======================================================= */

void applicationLayer(const char *msg) {
    int i;
    printf("\n====================================\nAPPLICATION LAYER\n====================================\n");
    printf("Application Data: %s\nBinary Stream:    ", msg);
    for (i = 0; msg[i]; i++) {
        char b[10]; getCharBinaryStr(msg[i], b); printf("%s ", b);
    }
    printf("\n");
}

void transportLayer(const char *msg, char *pay, const char *spb, const char *dpb) {
    int i;
    printf("\n====================================\nTRANSPORT LAYER\n====================================\n");
    printf("Source Port Bits: %s\nDest Port Bits:   %s\n", spb, dpb);
    printf("Added TCP Headers -> Segment Output:\n%s %s ", spb, dpb);
    pay[0] = '\0';
    for (i = 0; msg[i]; i++) {
        char b[10]; getCharBinaryStr(msg[i], b); printf("%s ", b); strcat(pay, b);
    }
    printf("\n");
}

void networkLayer(const char *pay, int psz, const char *sib, const char *dib, char *chain) {
    int len, totalP, p, b;
    printf("\n=================================================================\n");
    printf("LAYER 3 : NETWORK LAYER (PACKET FRAGMENTATION)\n");
    printf("=================================================================\n");
    printf("BINARY CONVERSION BEFORE FRAGMENTATION:\n");
    printf("Source IP Binary      : %s\n", sib);
    printf("Destination IP Binary : %s\n", dib);
    printf("Segment Payload Binary: %s\n", pay);
    printf("-----------------------------------------------------------------\n\n");

    len = strlen(pay);
    totalP = (len + psz - 1) / psz;
    chain[0] = '\0';
    for (p = 0; p < totalP; p++) {
        printf("[Packet %d] (Bits %d to %d) -> %s %s ", p + 1, p*psz, (p+1)*psz-1, sib, dib);
        strcat(chain, sib); strcat(chain, " "); strcat(chain, dib); strcat(chain, " ");
        for (b = 0; b < psz; b++) {
            int idx = (p * psz) + b;
            if (idx < len) {
                printf("%c", pay[idx]);
                char t[2]; t[0] = pay[idx]; t[1] = '\0'; strcat(chain, t);
            }
        }
        strcat(chain, " "); printf("\n\n");
    }
}

void dataLinkLayer(const char *filt, int psz, int fsz, const char *smb, const char *dmb, const char *sib, const char *dib, const char *spb, const char *dpb) {
    int slen, bitIdx, packetCount, totalFrames, k, b;
    printf("\n=================================================================\n");
    printf("LAYER 4 : DATA LINK LAYER (BIT-BASED SPLITTING WITH PADDING)\n");
    printf("=================================================================\n");

    slen = strlen(filt);
    bitIdx = 0; packetCount = 0; totalFrames = 0;

    while (bitIdx < slen) {
        int pStart, pEnd, currentFBit, frameInPCount;
        packetCount++;
        pStart = bitIdx; pEnd = bitIdx + psz - 1;

        printf("\n>>> PACKET %d (Bits %d to %d)\n", packetCount, pStart, pEnd);
        printf("    Added MAC Headers: Src[%s] Dst[%s]\n", smb, dmb);
        printf("\n    [Frames contained in Packet %d]:\n", packetCount);

        currentFBit = pStart; frameInPCount = 1;
        while (currentFBit <= pEnd) {
            int fEnd, paddingBits = 0;
            fEnd = currentFBit + fsz - 1;
            totalFrames++;

            printf("    - Frame %d (Bits %d to %d):\n", frameInPCount, currentFBit, fEnd);
            printf("      Payload Bits : ");
            for (b = currentFBit; b <= fEnd; b++) {
                if (b < slen && b <= pEnd) printf("%c", filt[b]);
                else paddingBits++;
            }

            printf("\n      Padding      : ");
            if (paddingBits == 0) printf("None");
            else { for(k=0; k<paddingBits; k++) printf("0"); }

            printf("\n      Full Stream  : %s %s %s %s %s %s ", smb, dmb, sib, dib, spb, dpb);
            for (b = currentFBit; b <= fEnd; b++) {
                if (b < slen && b <= pEnd) printf("%c", filt[b]);
                else printf("0");
            }
            printf("\n\n");

            currentFBit += fsz; frameInPCount++;
        }
        bitIdx += psz;
    }
    printf("=================================================================\n");
    printf("TRANSMISSION SUMMARY\n");
    printf("=================================================================\n");
    printf("Total Packets Generated : %d\n", packetCount);
    printf("Total Frames Generated  : %d\n", totalFrames);
    printf("=================================================================\n");
}

void physicalLayer(const char *filt, int fsz, const char *smb, const char *dmb, const char *sib, const char *dib, const char *spb, const char *dpb) {
    int slen, tf, f, b;
    printf("\n====================================\nPHYSICAL LAYER\n====================================\n");
    printf("Final combined Bitstream over physical medium:\n");
    slen = strlen(filt);
    tf = (slen + fsz - 1) / fsz;
    for (f = 0; f < tf; f++) {
        printf("%s %s %s %s %s %s ", smb, dmb, sib, dib, spb, dpb);
        for (b = 0; b < fsz; b++) {
            int idx = (f * fsz) + b;
            printf("%c", (idx < slen) ? filt[idx] : '0');
        }
        printf(" 00000000\n");
    }
}

/* =======================================================
   4. MENU LOGIC
   ======================================================= */

void handleStream() {
    char sUrl[MAX_URL], dUrl[MAX_URL], msg[100];
    int psz, fsz, sIdx, dIdx, i, len;
    char sib[100], dib[100], smb[100], dmb[100], spb[50], dpb[50], pay[2000], chain[5000], filt[5000];

    printf("\n--- SIMULATION CONFIGURATION ---\n");
    printf("Source URL: "); scanf("%s", sUrl);
    printf("Dest URL  : "); scanf("%s", dUrl);
    printf("Message   : "); scanf(" %[^\n]s", msg);
    printf("Packet Bit Size: "); scanf("%d", &psz);
    printf("Frame Bit Size : "); scanf("%d", &fsz);

    sIdx = searchTable(sUrl); dIdx = searchTable(dUrl);
    if (sIdx == -1 || dIdx == -1) { printf("\nError: URL not found in network table.\n"); return; }

    getIpBinaryStr(hashTable[sIdx].ip, sib); getIpBinaryStr(hashTable[dIdx].ip, dib);
    getMacBinaryStr(hashTable[sIdx].mac, smb); getMacBinaryStr(hashTable[dIdx].mac, dmb);
    getPortBinaryStr(1024, spb); getPortBinaryStr(8080, dpb);

    applicationLayer(msg);
    transportLayer(msg, pay, spb, dpb);
    networkLayer(pay, psz, sib, dib, chain);

    len = 0;
    for (i = 0; chain[i]; i++) {
        if (chain[i] == '0' || chain[i] == '1') filt[len++] = chain[i];
    }
    filt[len] = '\0';

    dataLinkLayer(filt, psz, fsz, smb, dmb, sib, dib, spb, dpb);
    physicalLayer(filt, fsz, smb, dmb, sib, dib, spb, dpb);
}

int main() {
    int choice, i;
    for(i=0; i<HASH_SIZE; i++) hashTable[i].is_occupied = 0;

    // Default Nodes
    insertNode("google.com", "142.250.190.46", "AA:BB:CC:DD:EE:FF");
    insertNode("bing.com", "13.107.21.200", "11:22:33:44:55:66");

    while (1) {
        printf("\n========== NETWORK TOOL MENU ==========\n");
        printf("1. Add New Network Node\n");
        printf("2. View Network Table\n");
        printf("3. Generate & Stream OSI Frame\n");
        printf("4. Exit Program\n");
        printf("=======================================\n");
        printf("Choice: ");

        if(scanf("%d", &choice) != 1) break;

        if (choice == 1) {
            char u[50], ip[16], m[18];
            printf("Enter URL, IP, and MAC: ");
            scanf("%s %s %s", u, ip, m);
            insertNode(u, ip, m);
            printf("Node added successfully.\n");
        } else if (choice == 2) {
            printTable();
        } else if (choice == 3) {
            handleStream();
        } else if (choice == 4) {
            printf("Exiting program...\n");
            break;
        } else {
            printf("Invalid choice. Try again.\n");
        }
    }
    return 0;
}
