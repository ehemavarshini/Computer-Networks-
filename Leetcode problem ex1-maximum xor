class Solution {
    class Node {
        Node[] next = new Node[2];
    }
    public int findMaximumXOR(int[] nums) {
        Node root = new Node();
        for (int n : nums) {
            Node curr = root;
            for (int i = 30; i >= 0; i--) {
                int bit = (n >> i) & 1;
                if (curr.next[bit] == null) curr.next[bit] = new Node();
                curr = curr.next[bit];
            }
        }
        int max = 0;
        for (int n : nums) {
            Node curr = root;
            int sum = 0;
            for (int i = 30; i >= 0; i--) {
                int bit = (n >> i) & 1;
                int opp = 1 - bit;
                if (curr.next[opp] != null) {
                    sum |= (1 << i);
                    curr = curr.next[opp];
                } else {
                    curr = curr.next[bit];
                }
            }
            if (sum > max) max = sum;
        }
        return max;
    }
}
