#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define MAX_URL 50
#define HASH_SIZE 5
#define BLOCK_SIZE 8

/* Global Constants */
char FLAG[] = "01111110";
char ESC[]  = "01111101";

struct HashEntry {
    char url[MAX_URL];
    char ip[16];
    char mac[18];
    int is_occupied;
};
struct HashEntry hashTable[HASH_SIZE];

/* --- UTILITY FUNCTIONS --- */
void charToBinary(char c, char *outStr) {
    int i;
    for (i = 7; i >= 0; i--) outStr[7 - i] = ((c >> i) & 1) + '0';
    outStr[8] = '\0';
}

char binaryToChar(const char *bin) {
    return (char)strtol(bin, NULL, 2);
}

void getIpBinaryStr(const char *ip, char *outStr) {
    int v[4], i;
    char temp[20], *token;
    strcpy(temp, ip);
    outStr[0] = '\0';
    token = strtok(temp, ".");
    while(token != NULL) {
        int val = atoi(token);
        char b[9];
        for (i = 7; i >= 0; i--) b[7-i] = ((val >> i) & 1) + '0';
        b[8] = '\0'; strcat(outStr, b);
        token = strtok(NULL, ".");
    }
}

/* --- LOGIC ENGINES --- */
void onesComplementAdd(char *sum, char *nextBlock) {
    int carry = 0, i;
    char tempSum[9]; tempSum[8] = '\0';
    for (i = 7; i >= 0; i--) {
        int s = (sum[i] - '0') + (nextBlock[i] - '0') + carry;
        tempSum[i] = (s % 2) + '0'; carry = s / 2;
    }
    if (carry == 1) {
        for (i = 7; i >= 0; i--) {
            int s = (tempSum[i] - '0') + carry;
            tempSum[i] = (s % 2) + '0'; carry = s / 2;
            if (carry == 0) break;
        }
    }
    strcpy(sum, tempSum);
}

void byteStuffing(const char *input, char *output) {
    int i = 0; char byte[9]; output[0] = '\0';
    while (input[i] != '\0') {
        strncpy(byte, &input[i], 8); byte[8] = '\0';
        if (strcmp(byte, FLAG) == 0 || strcmp(byte, ESC) == 0) strcat(output, ESC);
        strcat(output, byte); i += 8;
    }
}

void byteDestuffing(const char *input, char *output) {
    int i = 0; char byte[9]; output[0] = '\0';
    while (input[i] != '\0') {
        strncpy(byte, &input[i], 8); byte[8] = '\0';
        if (strcmp(byte, ESC) == 0) {
            i += 8; strncpy(byte, &input[i], 8); byte[8] = '\0';
        }
        strcat(output, byte); i += 8;
    }
}

/* --- MAIN MENU FUNCTIONS --- */
void insertNode(const char *u, const char *ip, const char *mac) {
    int sum = 0, i, idx;
    for (i = 0; u[i]; i++) sum += u[i];
    idx = sum % HASH_SIZE;
    while (hashTable[idx].is_occupied) idx = (idx + 1) % HASH_SIZE;
    strcpy(hashTable[idx].url, u); strcpy(hashTable[idx].ip, ip);
    strcpy(hashTable[idx].mac, mac); hashTable[idx].is_occupied = 1;
}

void viewHashTable() {
    int i;
    printf("\nIdx\tURL\t\tIP Address\tMAC Address\n");
    for(i=0; i<HASH_SIZE; i++) if(hashTable[i].is_occupied)
        printf("[%d]\t%-15s\t%-15s\t%-15s\n", i, hashTable[i].url, hashTable[i].ip, hashTable[i].mac);
}

/* --- SENDER SIDE --- */
void senderSide() {
    char sUrl[MAX_URL], dUrl[MAX_URL], msg[100];
    char appBin[800] = "", segPay[1000] = "", stuffedPay[1500] = "";
    char currentSum[9] = "00000000", checksum[9], pppFrame[2000], payWithCheck[1100];
    char sib[40], dib[40], pack[200];
    int i, pSize, packetSize, sI = -1, dI = -1, totalBits, numPackets, pad;
    FILE *f1, *f2;

    printf("\nSource URL: "); scanf("%s", sUrl);
    printf("Dest URL: "); scanf("%s", dUrl);
    for(i=0; i<HASH_SIZE; i++) {
        if(hashTable[i].is_occupied && strcmp(hashTable[i].url, sUrl)==0) sI = i;
        if(hashTable[i].is_occupied && strcmp(hashTable[i].url, dUrl)==0) dI = i;
    }
    if(sI == -1 || dI == -1) { printf("Error: Node not found.\n"); return; }

    printf("Message: "); scanf(" %[^\n]s", msg);
    printf("Packet Size: "); scanf("%d", &packetSize);
    printf("Physical Frame Size: "); scanf("%d", &pSize);

    getIpBinaryStr(hashTable[sI].ip, sib);
    getIpBinaryStr(hashTable[dI].ip, dib);

    /* 1. BYTE STUFFING (INTERNAL STEP FIRST) */
    for (i = 0; msg[i]; i++) { char b[9]; charToBinary(msg[i], b); strcat(appBin, b); }
    sprintf(segPay, "00000100000000000001111110010000%s", appBin);
    byteStuffing(segPay, stuffedPay);

    /* DISPLAY LAYERS */
    printf("\n====================================\nAPPLICATION LAYER\n====================================\nData: %s\nBinary: %s\n", msg, appBin);
    printf("\n====================================\nTRANSPORT LAYER\n====================================\nSegment Created: %s\n", segPay);
    printf("\n====================================\nNETWORK LAYER (FRAGMENTATION)\n====================================\n");
    totalBits = strlen(segPay);
    numPackets = (totalBits + packetSize - 1) / packetSize;
    for(i=0; i<numPackets; i++) {
        memset(pack, 0, sizeof(pack)); strncpy(pack, &segPay[i * packetSize], packetSize);
        printf("Packet %d: [IP Header] [Data: %s]\n", i+1, pack);
    }

    printf("\n====================================\nDATA LINK LAYER (FRAMING)\n====================================\n");
    printf("1. Checksum Calculation (Block-by-Block):\n");
    for (i = 0; i < (int)strlen(segPay); i += 8) {
        char chunk[9]; strncpy(chunk, &segPay[i], 8); chunk[8] = '\0';
        onesComplementAdd(currentSum, chunk);
        printf("   Block: %s | Running Sum: %s\n", chunk, currentSum);
    }
    strcpy(checksum, currentSum);
    for(i=0; i<8; i++) checksum[i] = (checksum[i] == '0') ? '1' : '0';
    printf("   Trailer Updated with Checksum: %s\n", checksum);

    // File 1: stuffing.txt
    f1 = fopen("stuffing.txt", "w");
    fprintf(f1, "BEFORE STUFFING: %s\nAFTER STUFFING:  %s", segPay, stuffedPay);
    fclose(f1);

    // File 2: ppp_format.txt
    sprintf(pppFrame, "%s | 11111111 | 00000011 | 0021 | %s | %s | %s", FLAG, stuffedPay, checksum, FLAG);
    f2 = fopen("ppp_format.txt", "w");
    fprintf(f2, "%s", pppFrame);
    fclose(f2);
    printf("2. Piped Frame built and saved to 'ppp_format.txt'\n");

    /* 2. PHYSICAL LAYER (LAST) */
    printf("\n====================================\nPHYSICAL LAYER\n====================================\n");
    pad = (pSize - (strlen(pppFrame) % pSize)) % pSize;
    printf("Serialized Stream with %d bit padding:\n%s", pad, pppFrame);
    for(i=0; i<pad; i++) printf("0");
    printf("\n");
}

/* --- RECEIVER SIDE --- */
void receiverSide() {
    FILE *fp, *outFp;
    char ppp[2000], stuffed[1500], destuffed[1200], trailer[9], verifySum[9] = "00000000";
    char calcChecksum[9]; // Variable to store receiver-side calculated checksum
    char temp[2000], *token;
    int i, choice, err = 0;

    fp = fopen("ppp_format.txt", "r");
    if(!fp) { printf("Error: ppp_format.txt not found.\n"); return; }
    fgets(ppp, 2000, fp); fclose(fp);

    strcpy(temp, ppp);
    token = strtok(temp, "|");
    for(i=0; i<4; i++) token = strtok(NULL, "|");
    strcpy(stuffed, token + 1); stuffed[strlen(stuffed)-1] = '\0';
    token = strtok(NULL, "|");
    strcpy(trailer, token + 1); trailer[strlen(trailer)-1] = '\0';

    byteDestuffing(stuffed, destuffed);

    printf("\nInject Error? (1:Yes, 0:No): "); scanf("%d", &choice);
    if(choice == 1) {
        int blockNum, bitIdx, globalIdx;
        int totalBlocks = strlen(destuffed) / 8;
        printf("Available Blocks: 1 to %d\n", totalBlocks);
        printf("Enter Block Number: "); scanf("%d", &blockNum);
        printf("Enter Bit Index (0-7): "); scanf("%d", &bitIdx);
        globalIdx = (blockNum - 1) * 8 + bitIdx;
        if(globalIdx >= 0 && globalIdx < (int)strlen(destuffed)) {
            destuffed[globalIdx] = (destuffed[globalIdx] == '0') ? '1' : '0';
            printf("--- Bit Flipped at Block %d, Index %d! ---\n", blockNum, bitIdx);
        }
    }

    outFp = fopen("receiver_output.txt", "w");
    fprintf(outFp, "--- RECEIVER LOG ---\nDESTUFFED PAYLOAD: %s\n\nCHECKSUM VERIFICATION:\n", destuffed);
    for (i = 0; i < (int)strlen(destuffed); i += 8) {
        char chunk[9]; strncpy(chunk, &destuffed[i], 8); chunk[8] = '\0';
        onesComplementAdd(verifySum, chunk);
        fprintf(outFp, "Block: %s | Sum: %s\n", chunk, verifySum);
    }
    strcpy(calcChecksum, verifySum);
    for(i=0; i<8; i++) calcChecksum[i] = (calcChecksum[i] == '0') ? '1' : '0';
    fprintf(outFp, "Calculated Checksum: %s\n", calcChecksum);
    onesComplementAdd(verifySum, trailer);
    fprintf(outFp, "Final Sum (with Trailer): %s\n", verifySum);
    for(i=0; i<8; i++) if(verifySum[i] == '0') err = 1;
    if(err) printf("\nDECISION: Error occurs / Invalid Data!\n");
    else printf("\nDECISION: Error not present / Valid Data!\n");
    fclose(outFp);
    printf("[RECEIVER] Verification logged to 'receiver_output.txt'\n");
}

int main() {
    int choice, i;
    for(i=0; i<HASH_SIZE; i++) hashTable[i].is_occupied = 0;
    insertNode("google.com", "142.250.190.46", "AA:BB:CC:DD:EE:FF");
    insertNode("bing.com", "13.107.21.200", "11:22:33:44:55:66");

    while(1) {
        printf("\n========== MENU ==========\n1. Add Node\n2. View Table\n3. Sender Side\n4. Receiver Side\n5. Exit\nChoice: ");
        if(scanf("%d", &choice) != 1) break;
        if(choice == 1) {
            char u[50], ip[20], mac[20]; printf("Enter URL IP MAC: "); scanf("%s %s %s", u, ip, mac); insertNode(u, ip, mac);
        }
        else if(choice == 2) viewHashTable();
        else if(choice == 3) senderSide();
        else if(choice == 4) receiverSide();
        else break;
    }
    return 0;
}
